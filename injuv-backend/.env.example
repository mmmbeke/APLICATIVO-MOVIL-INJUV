# Cadena de conexión de Neon (la misma base de datos que usa la plataforma web)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb
DB_SSLMODE=require

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambia-esto
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Lista separada por comas, o * para permitir cualquier origen
CORS_ORIGINS=*

# werkzeug (compatible con el login de la web) o bcrypt
PASSWORD_HASH_SCHEME=werkzeug

NOTICIAS_IMAGEN_BASE_URL=https://plataforma-web-injuv.onrender.com/api/noticias/imagen/
TIMEZONE=America/Santiago
